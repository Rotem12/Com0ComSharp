<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <Version>0.1.0</Version>
    <Description>Windows com0com driver and virtual serial port management with UAC elevation and diagnostics.</Description>
    <Authors>Rotem12</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Rotem12/Com0ComSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>com0com;serial;virtual-com;windows;driver</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Com0ComSharp.Tests" />
  </ItemGroup>
</Project>
