<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <runtime>
    <!-- Use the OS TLS policy on older Framework targets without changing
         ServicePointManager or the machine registry from library code. -->
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSystemDefaultTlsVersions=false;Switch.System.Net.DontEnableSchUseStrongCrypto=false" />
  </runtime>
</configuration>
